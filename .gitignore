# Build output (CMake + regenerated mascot intermediates and previews)
/build/
/out/
CMakeUserPresets.json

# Local tooling (recreated by tools/setup.ps1)
/.venv/
/.deps/

# Superseded art kept locally only
/art/archive/

# Python
__pycache__/
*.py[cod]

# Solu (the voice assistant): the source is tracked; its Python environment, models and scratch files are not
/solu/venv/
/solu/models/
/solu/dev/
/solu/*.log

# The product website (its own project; lives here for convenience, not part of this repo's history)
/website/

# Blender backups
*.blend1

# Editors / OS
.vs/
.vscode/
*.user
Thumbs.db
Desktop.ini
